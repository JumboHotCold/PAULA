# Template only. Never commit real credentials. The current development Compose
# uses an external env file; this template does not replace or change that file.
USE_POSTGRES=true
POSTGRES_DB=paulibot_db
POSTGRES_USER=paulibot_user
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=3
DJANGO_SECRET_KEY=
PAULA_DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
PAULA_FRONTEND_ORIGIN=http://localhost:5173
PAULA_GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
PAULA_GROQ_ENABLED=true
PAULA_OPENAI_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=
PAULA_GENERATION_DEADLINE_SECONDS=4
PAULA_PROVIDER_CALL_TIMEOUT_SECONDS=3
PAULA_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_MAX_COSINE_DISTANCE=0.45
# Hosted deployment must explicitly select paulibot.settings_production, set
# PAULA_DJANGO_DEBUG=false, strong secrets, real hosts and HTTPS origins below.
# CORS_ALLOWED_ORIGINS=https://paula.example.edu.ph
# CSRF_TRUSTED_ORIGINS=https://paula.example.edu.ph,https://api.example.edu.ph
# PAULA_TRUST_HTTPS_PROXY=false
